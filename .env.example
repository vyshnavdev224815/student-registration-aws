# Copy these values into your EC2 systemd unit or a local .env file that is never committed.
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
# On EC2, use the RDS-managed Secrets Manager ARN instead of DB_USER/DB_PASSWORD.
DB_SECRET_ARN=your-rds-managed-secret-arn
# For local testing without Secrets Manager, omit DB_SECRET_ARN and set these:
DB_USER=your_database_user
DB_PASSWORD=replace_with_your_database_password
DB_NAME=studentdb
S3_BUCKET_NAME=your-unique-student-photo-bucket
MAX_UPLOAD_MB=5
